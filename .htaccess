Options -Indexes

RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1|\[::1\])$ [NC]
RewriteCond %{HTTP_HOST} !\.localhost$ [NC]
RewriteRule ^ https://%{SERVER_NAME}%{REQUEST_URI} [R=301,L]

<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
    Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; img-src 'self' data: blob: https:; font-src 'self' data: https:; style-src 'self' 'unsafe-inline' https:; script-src 'self' 'unsafe-inline' https://unpkg.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; connect-src 'self' https:; upgrade-insecure-requests"
</IfModule>

<FilesMatch "^(install\.lock|\.env|composer\.(json|lock))$">
    Require all denied
</FilesMatch>


ErrorDocument 403 /Appjoteca/errors/403/403.php
ErrorDocument 404 /Appjoteca/errors/404/404.php